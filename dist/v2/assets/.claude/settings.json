{
  "statusLine": {
    "type": "command",
    "command": "node \"$CLAUDE_PROJECT_DIR/.claude/statusline/benchagi-statusline.mjs\"",
    "padding": 0
  },
  "outputStyle": "BenchAGI",
  "hooks": {
    "SessionStart": [
      { "matcher": "startup|resume", "hooks": [ { "type": "command", "command": "node \"$BENCHAGI_SEAT_HOOK\" session_start" } ] }
    ],
    "Notification": [
      { "hooks": [ { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/benchagi-attention.mjs\" hook-notification" } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [
        { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/benchagi-attention.mjs\" clear" },
        { "type": "command", "command": "node \"$BENCHAGI_SEAT_HOOK\" user_prompt" }
      ] }
    ],
    "PostToolUse": [
      { "matcher": "*", "hooks": [ { "type": "command", "command": "node \"$BENCHAGI_SEAT_HOOK\" tool_result" } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "node \"$BENCHAGI_SEAT_HOOK\" session_stop" } ] }
    ]
  }
}
