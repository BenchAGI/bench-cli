# agent-chat relay — environment template. Copy to .env and fill in.
# .env is gitignored; NEVER commit real secrets.

# Required ----------------------------------------------------------------
# The Firestore instance this relay serves.
INSTANCE_ID=

# Absolute path to a Firebase Admin service-account JSON for FIREBASE_PROJECT_ID.
# Keep this file OUTSIDE any git repo (e.g. ~/.config/benchagi/firebase-admin.json).
# Note: ~ is NOT expanded — use an absolute path.
FIREBASE_SERVICE_ACCOUNT_PATH=

# Gateway bearer token (gateway.auth.token in ~/.openclaw/openclaw.json).
# Required when GATEWAY_URL points at a token-gated OpenClaw gateway.
GATEWAY_TOKEN=

# Optional (defaults shown in comments) ----------------------------------
# OpenClaw gateway base URL (default http://127.0.0.1:18789).
GATEWAY_URL=

# Firebase project id (default benchagi-8ea90).
FIREBASE_PROJECT_ID=

# Per-turn stream timeout in seconds (default 180).
GATEWAY_TIMEOUT_SECONDS=

# Max inbound turns processed concurrently (default 3).
MAX_CONCURRENT_INBOUND=

# Presence heartbeat interval in seconds (default 25).
HEARTBEAT_INTERVAL_SECONDS=

# Log level: DEBUG | INFO | WARNING | ERROR (default INFO).
LOG_LEVEL=

# Machine routing (multi-machine compute) --------------------------------
# This box's routing id and display label. When set, the relay claims only
# turns whose runOn matches — stamping the machine onto every run/outbound for
# the UI device indicator, and writing a per-machine presence doc
# (gatewayStatus/chatRuntime-{MACHINE_ID}).
# EMPTY (default) = unscoped: claim everything, ignore runOn (single-runtime).
#   primary:  MACHINE_ID=mbp  MACHINE_NAME="MacBook Pro"  (FALLBACK_FOR unset)
#   fallback: MACHINE_ID=mini MACHINE_NAME="Mac Mini"     FALLBACK_FOR=mbp
MACHINE_ID=
MACHINE_NAME=

# If this box is a fallback, the primary machine id whose presence-staleness
# (>90s) lets it take over primary-targeted turns. Empty = not a fallback.
FALLBACK_FOR=
